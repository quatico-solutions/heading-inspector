{
  "manifest_version": 3,
  "name": "Heading Inspector",
  "description": "Shows accessibility tree with heading structure (h1–h6) as screen readers see it. Finds sequence errors.",
  "version": "0.1.1",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "debugger", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Heading Inspector (click to toggle)",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png"
    }
  }
}
